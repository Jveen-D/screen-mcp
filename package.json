{
  "name": "screen-component-mcp",
  "version": "0.1.0",
  "description": "MCP server that maps screen design components to full editor schemas.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http-server.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "build": "tsc -p tsconfig.json",
    "test:flow": "tsx scripts/test-flow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
